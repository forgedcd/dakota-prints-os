# Dakota Prints OS — environment (backend / admin app)
PORT=5000
SESSION_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=./data/dakota.db
UPLOAD_DIR=./data/uploads

# Seeded staff logins (applied on boot)
ADMIN_EMAIL=admin@dakotaprints.com
ADMIN_PASSWORD=ForgedOS2026!

# Token the public website must send as x-webhook-token when POSTing orders
OS_WEBHOOK_TOKEN=dakota-website-2026

# Public site this OS backs — shown in Settings → Website integration and used
# for the connection check / catalog-sync target.
WEBSITE_URL=https://www.dakotaprints.com

# Browser origins allowed to read /api/public/* (comma-separated). '*' in dev.
WEBSITE_ORIGINS=*

# Who gets pinged when a customer asks for "Design it for me"
DESIGN_NOTIFY_EMAIL=orders@dakotaprints.com

# Opt-in demo data: seeds ~23 sample orders + 12 demo customers on first boot
# (fresh database only). Leave false in production so only the real product
# catalog, staff accounts and shop settings are seeded — no fake orders mixed
# into real data. Admins can also wipe orders later via Settings → Clear all
# orders (requires typing DELETE ALL ORDERS to confirm).
SEED_DEMO_ORDERS=false

# Optional integrations (stubbed — see README "Where the real services drop in")
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
